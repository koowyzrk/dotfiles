* {
    primary: #252626;
    primary-fixed: #856335;
    on-primary: #353231;
    on-primary-fixed: #252626;
    on-secondary: #FAF0C6;
    secondary-container: #FAF0C6;
    on-secondary-container: #cce8ea;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #0e1415;
    on-surface: #dee4e4;
    on-highlight: rgba(255, 255, 255, 0.15);
}
